# Public Supabase project values. These are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical production origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# At least 32 random bytes. Used to pseudonymize rate-limit identifiers.
RATE_LIMIT_HMAC_SECRET=

# Optional. Leave blank until genuine values are available.
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_ID=
